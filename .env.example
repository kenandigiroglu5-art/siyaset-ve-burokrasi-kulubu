# Bu dosya örnektir — gerçek değerleri buraya YAZMAYIN.
# Gerçek değerleri yerelde ".env.local" dosyasına (git'e commit edilmez),
# canlıda ise Vercel Project Settings → Environment Variables'a girin.

# --- İletişim formu (SMTP) ---
SMTP_USER=Siyasetburokrasi@outlook.com
SMTP_PASS=
CONTACT_TO_EMAIL=Siyasetburokrasi@outlook.com

# --- Instagram gönderileri (Instagram Graph API) ---
# Instagram Business/Creator hesabına bağlı, uzun ömürlü bir erişim token'ı.
INSTAGRAM_ACCESS_TOKEN=
# Hesabın Instagram kullanıcı/işletme ID'si.
INSTAGRAM_USER_ID=
